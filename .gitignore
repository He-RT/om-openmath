/ios/TestResults/
/ios/OpenMath/Resources/RustNotices/
/macos/Local.xcconfig
/macos/TestResults/
/macos/OpenMathNative/Resources/AgentRuntime/
xcuserdata/
*.xcuserstate
/*.xcresult/
