              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "completed",
            "partial",
            "failed",
            "unavailable"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "part_id",
        "tool_call_id",
        "operation_ref",
        "result_ref",
        "outcome"
      ],
      "additionalProperties": false
