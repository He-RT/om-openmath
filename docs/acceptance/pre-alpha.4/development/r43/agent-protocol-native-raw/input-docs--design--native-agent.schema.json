              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentMessagePart"
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "record_type",
        "message_version",
        "message_id",
        "role",
        "agent_turn_id",
        "task_id",
        "parts"
      ],
      "additionalProperties": false
    },
