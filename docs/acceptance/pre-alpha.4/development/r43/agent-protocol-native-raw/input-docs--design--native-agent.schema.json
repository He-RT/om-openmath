{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmath.dev/schemas/native-agent-v1.json",
  "title": "Private native Agent IPC and OpenMath canonical messages",
  "description": "Shape is not permission. Host owns connection/task/document/grants and admission IDs. Credentials and arbitrary transport URLs are not frame fields. UTF8 NDJSON frames are at most 1MiB; immutable canonical events require durable ACK. Helper settled is loop state, not proof of mathematical/task success.",
  "oneOf": [
    {
      "$ref": "#/$defs/AgentIPCFrame"
    },
    {
      "$ref": "#/$defs/NativeAgentHostCommand"
    },
    {
      "$ref": "#/$defs/NativeAgentHostReply"
    }
  ],
  "$defs": {
    "Identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Serial": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "共同可精确表示的单调计数；不能静默回绕。"
    },
    "Sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "AgentToolName": {
      "type": "string",
      "enum": [
        "read_notebook",
        "search_functions",
        "get_function_docs",
        "preview_source",
        "apply_notebook_patch",
        "run_cells",
        "inspect_result",
        "evaluate_scratch",
        "read_attachment",
        "prepare_attachment",
        "get_operation_status",
        "undo_transaction"
      ]
    },
    "AgentTextPart": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "text"
        },
        "part_id": {
          "$ref": "#/$defs/Identity"
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        }
      },
      "required": [
        "kind",
        "part_id",
        "text"
      ],
      "additionalProperties": false
    },
    "AgentMediaPart": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "media"
        },
        "part_id": {
          "$ref": "#/$defs/Identity"
        },
        "media_ref": {
          "$ref": "#/$defs/Identity"
        },
        "submission_kind": {
          "enum": [
            "image",
            "audio",
            "video",
            "file"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "part_id",
        "media_ref",
        "submission_kind"
      ],
      "additionalProperties": false
    },
    "AgentToolProposalPart": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "tool_call"
        },
        "part_id": {
          "$ref": "#/$defs/Identity"
        },
        "tool_call_id": {
          "$ref": "#/$defs/Identity"
        },
        "name": {
          "$ref": "#/$defs/AgentToolName"
        },
        "arguments_json": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "kind",
        "part_id",
        "tool_call_id",
        "name",
        "arguments_json"
      ],
      "additionalProperties": false
    },
    "AgentToolResultPart": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "tool_result"
        },
        "part_id": {
          "$ref": "#/$defs/Identity"
        },
        "tool_call_id": {
          "$ref": "#/$defs/Identity"
        },
        "operation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_ref": {
          "anyOf": [
