{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmath:native-preview:v1",
  "title": "Actual frozen source-preview arguments/data",
  "description": "Subset copied from agent-tools schema; live tool registration, trusted scope and commit fences remain host-owned. No source-only preview authorizes a write.",
  "$defs": {
    "Identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "CellIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "源码单元格ID沿用.omnb v1的非空文本；按原UTF8区分，不作为路径或operation身份。"
    },
    "Sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "Serial": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "共同可精确表示的单调计数；不能静默回绕。"
    },
    "Dialect": {
      "type": "string",
      "enum": [
        "Modern",
        "Wolfram",
        "Auto"
      ]
    },
    "PreviewSource": {
      "type": "string",
      "minLength": 0,
      "maxLength": 65536,
      "description": "数学或 Markdown 源码；仅交给对应解析器，不是宿主脚本。"
    },
    "PreviewExistingCell": {
      "type": "object",
      "properties": {
        "cell_id": {
          "$ref": "#/$defs/CellIdentity"
        }
      },
      "required": [
        "cell_id"
      ],
      "additionalProperties": false
    },
    "PreviewNewCell": {
      "type": "object",
      "properties": {
        "client_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "client_key"
      ],
      "additionalProperties": false
    },
    "PreviewCellSelector": {
      "oneOf": [
        {
          "$ref": "#/$defs/PreviewExistingCell"
        },
        {
          "$ref": "#/$defs/PreviewNewCell"
        }
      ]
    },
    "PreviewInsertCell": {
      "type": "object",
      "properties": {
        "type": {
          "const": "insert_cell"
        },
        "client_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreviewCellSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "Math",
            "Text"
          ]
        },
        "dialect": {
          "$ref": "#/$defs/Dialect"
        },
        "source": {
          "$ref": "#/$defs/PreviewSource"
        }
      },
      "required": [
        "type",
        "client_key",
        "after",
        "kind",
        "dialect",
        "source"
      ],
      "additionalProperties": false
    },
    "PreviewUpdateCell": {
      "type": "object",
      "properties": {
        "type": {
          "const": "update_cell"
        },
        "target": {
          "$ref": "#/$defs/PreviewExistingCell"
        },
        "expected_source_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "source": {
          "$ref": "#/$defs/PreviewSource"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Math",
            "Text"
          ]
        },
        "dialect": {
          "$ref": "#/$defs/Dialect"
        }
      },
      "required": [
        "type",
        "target",
        "expected_source_hash",
        "source"
      ],
      "additionalProperties": false
    },
    "PreviewReplaceText": {
      "type": "object",
      "properties": {
        "type": {
          "const": "replace_text"
        },
        "target": {
          "$ref": "#/$defs/PreviewExistingCell"
        },
        "expected_source_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "match": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "replacement": {
          "$ref": "#/$defs/PreviewSource"
        }
      },
      "required": [
        "type",
        "target",
        "expected_source_hash",
        "match",
        "replacement"
      ],
      "additionalProperties": false
    },
    "PreviewDeleteCell": {
      "type": "object",
      "properties": {
        "type": {
          "const": "delete_cell"
        },
        "target": {
          "$ref": "#/$defs/PreviewExistingCell"
        },
        "expected_source_hash": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "type",
        "target",
        "expected_source_hash"
      ],
      "additionalProperties": false
    },
    "PreviewMoveCell": {
      "type": "object",
      "properties": {
        "type": {
          "const": "move_cell"
        },
        "target": {
          "$ref": "#/$defs/PreviewCellSelector"
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreviewCellSelector"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "target",
        "after"
      ],
      "additionalProperties": false
    },
    "PreviewRenameNotebook": {
      "type": "object",
      "properties": {
        "type": {
          "const": "rename_notebook"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false
    },
    "PreviewPatchOperation": {
      "oneOf": [
        {
          "$ref": "#/$defs/PreviewInsertCell"
        },
        {
          "$ref": "#/$defs/PreviewUpdateCell"
        },
        {
          "$ref": "#/$defs/PreviewReplaceText"
        },
        {
          "$ref": "#/$defs/PreviewDeleteCell"
        },
        {
          "$ref": "#/$defs/PreviewMoveCell"
        },
        {
          "$ref": "#/$defs/PreviewRenameNotebook"
        }
      ]
    },
    "PreviewSourceInput": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "source"
        },
        "source": {
          "$ref": "#/$defs/PreviewSource"
        },
        "dialect": {
          "$ref": "#/$defs/Dialect"
        }
      },
      "required": [
        "kind",
        "source",
        "dialect"
      ],
      "additionalProperties": false
    },
    "PreviewPatchInput": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "patch"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreviewPatchOperation"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "kind",
        "operations"
      ],
      "additionalProperties": false
    },
    "NativePreviewInput": {
      "oneOf": [
        {
          "$ref": "#/$defs/PreviewSourceInput"
        },
        {
          "$ref": "#/$defs/PreviewPatchInput"
        }
      ]
    },
    "NativePreviewArgs": {
      "type": "object",
      "properties": {
        "snapshot_ref": {
          "$ref": "#/$defs/Identity"
        },
        "input": {
          "$ref": "#/$defs/NativePreviewInput"
        }
      },
      "required": [
        "snapshot_ref",
        "input"
      ],
      "additionalProperties": false
    },
    "NativePreviewDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "hint"
          ]
        },
        "cell_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/CellIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_utf8": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "end_utf8": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "severity",
        "cell_id",
        "start_utf8",
        "end_utf8"
      ],
      "additionalProperties": false
    },
    "NativePreviewData": {
      "type": "object",
      "properties": {
        "preview_kind": {
          "type": "string",
          "enum": [
            "source",
            "patch"
          ]
        },
        "valid": {
          "type": "boolean"
        },
        "preview_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativePreviewDiagnostic"
          },
          "maxItems": 100
        },
        "affected_cell_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CellIdentity"
          },
          "maxItems": 1000
        },
        "assigned_cell_ids": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CellIdentity"
          }
        }
      },
      "required": [
        "preview_kind",
        "valid",
        "preview_ref",
        "plan_hash",
        "diagnostics",
        "affected_cell_ids",
        "assigned_cell_ids"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/NativePreviewArgs"
    },
    {
      "$ref": "#/$defs/NativePreviewData"
    }
  ]
}
